/* 기준 해상도 1920x1080 (PanelSettings: ScaleWithScreenSize, 높이 기준)에서 읽기 좋은 크기 */
.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 24px;
}

.hidden {
    display: none;
}

/* 데이터 소스 표시줄: 화면 위 가운데에 항상 표시한다. 가상 데이터와 수신 데이터를 혼동하지 않게 한다. */
/* 좌우 패널(왼쪽 목록 약 440px, 오른쪽 상세 약 640px) 사이의 빈 영역에 둔다. 문구가 길어져도 패널과 겹치지 않게 한다. */
.source-bar {
    position: absolute;
    left: 480px;
    right: 680px;
    top: 14px;
    flex-direction: row;
    justify-content: center;
}

.source-status {
    font-size: 18px;
    -unity-font-style: bold;
    padding: 6px 14px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    background-color: rgba(16, 20, 26, 0.9);
    color: rgb(236, 240, 246);
}

.source-simulated {
    background-color: rgba(122, 82, 0, 0.92);
    color: rgb(255, 222, 128);
}

.source-mavlink {
    background-color: rgba(0, 72, 92, 0.92);
    color: rgb(160, 236, 255);
}

.source-error {
    background-color: rgba(120, 22, 22, 0.94);
    color: rgb(255, 178, 178);
}

.panel {
    background-color: rgba(16, 20, 26, 0.86);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    padding: 18px;
    color: rgb(236, 240, 246);
}

.panel-title {
    font-size: 28px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

/* 목록 패널 */
/* 높이를 비율로 제한하지 않는다. 부모가 내용에 따라 늘어나는 열이라 고정 패널이 생기면 목록이 줄어 스크롤바가 생겼다.
   유닛 7기(행 70px)까지는 스크롤 없이 모두 보이고, 그보다 많으면 스크롤한다. */
.list-panel {
    width: 440px;
    flex-shrink: 0;
}

.unit-list {
    flex-shrink: 0;
    max-height: 490px;
}

.unit-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    margin-bottom: 6px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    border-left-width: 6px;
    border-left-color: rgba(0, 0, 0, 0);
}

.unit-row:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.unit-row.selected {
    background-color: rgba(70, 130, 220, 0.42);
    border-left-color: rgb(110, 170, 255);
}

.status-dot {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    margin-right: 12px;
}

.kind-badge {
    width: 64px;
    font-size: 20px;
    color: rgb(185, 195, 210);
}

.unit-id {
    flex-grow: 1;
    font-size: 24px;
    -unity-font-style: bold;
}

.unit-status {
    font-size: 22px;
}

.status-normal {
    color: rgb(64, 230, 89);
}

.status-warning {
    color: rgb(255, 204, 26);
}

.status-lost {
    color: rgb(240, 70, 70);
}

.status-dot.status-normal {
    background-color: rgb(64, 230, 89);
}

.status-dot.status-warning {
    background-color: rgb(255, 204, 26);
}

.status-dot.status-lost {
    background-color: rgb(240, 70, 70);
}

.overview-button {
    margin-top: 12px;
    height: 48px;
    font-size: 22px;
}

/* 상세 패널 */
.detail-panel {
    width: 640px;
}

.detail-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 6px 0;
}

/* 라벨은 줄어들지 않게 고정하고, 값은 남은 폭 안에서 줄바꿈한다. (통신 줄이 잘리지 않도록) */
.detail-key {
    width: 250px;
    flex-shrink: 0;
    font-size: 22px;
    color: rgb(185, 195, 210);
}

.detail-value {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    font-size: 24px;
    white-space: normal;
    -unity-text-align: upper-right;
}

/* 카메라 패널: 상세 패널 아래에 같은 폭으로 쌓는다. */
.right-column {
    width: 640px;
    flex-direction: column;
    align-items: stretch;
}

.camera-panel {
    margin-top: 12px;
}

/* 영상(16:9)이 프레임을 빈틈없이 채우도록 폭에 맞춘다. 선택 패널 폭 602px -> 339px */
.camera-frame {
    height: 339px;
    background-color: rgb(0, 0, 0);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
}

.camera-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.camera-lost {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(240, 70, 70);
    background-color: rgba(0, 0, 0, 0.7);
    padding: 8px 20px;
    border-radius: 6px;
}

.camera-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.camera-title {
    font-size: 28px;
    -unity-font-style: bold;
}

.camera-button {
    height: 40px;
    min-width: 96px;
    font-size: 20px;
}

/* 고정 패널은 왼쪽 목록 아래에 둔다. 두 패널을 합쳐도 1080 높이 안에 들어가야 한다. */
.left-column {
    width: 440px;
    flex-direction: column;
    align-items: stretch;
}

.pinned-panel {
    margin-top: 12px;
}

/* 고정 패널 폭 402px -> 226px */
.pinned-frame {
    height: 226px;
}
