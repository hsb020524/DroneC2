/* 기준 해상도 1920x1080 (PanelSettings: ScaleWithScreenSize, 높이 기준)에서 읽기 좋은 크기 */
.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 24px;
}

.hidden {
    display: none;
}

.panel {
    background-color: rgba(16, 20, 26, 0.86);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    padding: 18px;
    color: rgb(236, 240, 246);
}

.panel-title {
    font-size: 28px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

/* 목록 패널 */
.list-panel {
    width: 440px;
    max-height: 75%;
}

.unit-list {
    flex-shrink: 1;
}

.unit-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    margin-bottom: 6px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    border-left-width: 6px;
    border-left-color: rgba(0, 0, 0, 0);
}

.unit-row:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.unit-row.selected {
    background-color: rgba(70, 130, 220, 0.42);
    border-left-color: rgb(110, 170, 255);
}

.status-dot {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    margin-right: 12px;
}

.kind-badge {
    width: 64px;
    font-size: 20px;
    color: rgb(185, 195, 210);
}

.unit-id {
    flex-grow: 1;
    font-size: 24px;
    -unity-font-style: bold;
}

.unit-status {
    font-size: 22px;
}

.status-normal {
    color: rgb(64, 230, 89);
}

.status-warning {
    color: rgb(255, 204, 26);
}

.status-lost {
    color: rgb(240, 70, 70);
}

.status-dot.status-normal {
    background-color: rgb(64, 230, 89);
}

.status-dot.status-warning {
    background-color: rgb(255, 204, 26);
}

.status-dot.status-lost {
    background-color: rgb(240, 70, 70);
}

.overview-button {
    margin-top: 12px;
    height: 48px;
    font-size: 22px;
}

/* 상세 패널 */
.detail-panel {
    width: 640px;
}

.detail-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 6px 0;
}

/* 라벨은 줄어들지 않게 고정하고, 값은 남은 폭 안에서 줄바꿈한다. (통신 줄이 잘리지 않도록) */
.detail-key {
    width: 250px;
    flex-shrink: 0;
    font-size: 22px;
    color: rgb(185, 195, 210);
}

.detail-value {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    font-size: 24px;
    white-space: normal;
    -unity-text-align: upper-right;
}

/* 카메라 패널: 상세 패널 아래에 같은 폭으로 쌓는다. */
.right-column {
    width: 640px;
    flex-direction: column;
    align-items: stretch;
}

.camera-panel {
    margin-top: 12px;
}

.camera-frame {
    height: 324px;
    background-color: rgb(0, 0, 0);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
}

.camera-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.camera-lost {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(240, 70, 70);
    background-color: rgba(0, 0, 0, 0.7);
    padding: 8px 20px;
    border-radius: 6px;
}
