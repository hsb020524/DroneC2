.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 16px;
}

.hidden {
    display: none;
}

.panel {
    background-color: rgba(16, 20, 26, 0.82);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    padding: 12px;
    color: rgb(230, 234, 240);
}

.panel-title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

/* 목록 패널 */
.list-panel {
    width: 300px;
    max-height: 70%;
}

.unit-list {
    flex-shrink: 1;
}

.unit-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin-bottom: 4px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.05);
    border-left-width: 4px;
    border-left-color: rgba(0, 0, 0, 0);
}

.unit-row:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

.unit-row.selected {
    background-color: rgba(70, 130, 220, 0.38);
    border-left-color: rgb(110, 170, 255);
}

.status-dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-right: 8px;
}

.kind-badge {
    width: 40px;
    font-size: 12px;
    color: rgb(170, 180, 195);
}

.unit-id {
    flex-grow: 1;
    font-size: 15px;
    -unity-font-style: bold;
}

.unit-status {
    font-size: 13px;
}

.status-normal {
    color: rgb(64, 230, 89);
}

.status-warning {
    color: rgb(255, 204, 26);
}

.status-lost {
    color: rgb(230, 51, 51);
}

.status-dot.status-normal {
    background-color: rgb(64, 230, 89);
}

.status-dot.status-warning {
    background-color: rgb(255, 204, 26);
}

.status-dot.status-lost {
    background-color: rgb(230, 51, 51);
}

.overview-button {
    margin-top: 8px;
    height: 30px;
}

/* 상세 패널 */
.detail-panel {
    width: 340px;
}

.detail-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 3px 0;
}

.detail-key {
    width: 60px;
    color: rgb(150, 160, 175);
}

.detail-value {
    flex-grow: 1;
    -unity-text-align: middle-right;
}
