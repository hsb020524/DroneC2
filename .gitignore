# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / VS Code / Rider cache
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS
.DS_Store
Thumbs.db

# Cesium ion access token (per developer, never commit)
/[Aa]ssets/CesiumSettings/Resources/CesiumIonServers/ion.cesium.com.asset
/[Aa]ssets/CesiumSettings/Resources/CesiumIonServers/ion.cesium.com.asset.meta
# Cesium runtime settings also has a default ion access token field
/[Aa]ssets/CesiumSettings/Resources/CesiumRuntimeSettings.asset
/[Aa]ssets/CesiumSettings/Resources/CesiumRuntimeSettings.asset.meta
# Cesium settings folder (token holders only; empty folder metas add noise)
/[Aa]ssets/CesiumSettings*

# Optional dev tool (embedded package, see README); never commit
/[Pp]ackages/com.coplaydev.unity-mcp/
/[Pp]ackages/com.coplaydev.unity-mcp.meta

# Python bytecode (tools/ scripts import each other)
__pycache__/
*.pyc

# ArduPilot SITL working files (written to the current directory if a SITL binary is run from the repo)
/eeprom.bin
/logs/
/terrain/
/mav.parm
/mav.tlog
/mav.tlog.raw
/*.tlog
/*.rlog

# Personal Claude Code notes (not published)
/CLAUDE.local.md
